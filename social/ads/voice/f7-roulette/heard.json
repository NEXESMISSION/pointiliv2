{
 "phrases": [
  {
   "a": 0,
   "z": 3.16,
   "text": "تحب الحرغيف يستنى الكادو؟"
  },
  {
   "a": 3.16,
   "z": 5.25,
   "text": "كيما يستنى الماتش"
  },
  {
   "a": 5.25,
   "z": 7.125,
   "text": "حدم الروليت"
  },
  {
   "a": 7.125,
   "z": 8.825,
   "text": "يكمل الكات"
  },
  {
   "a": 8.825,
   "z": 10.285,
   "text": "ياخدورة"
  },
  {
   "a": 10.285,
   "z": 12.39,
   "text": "إدورها في تلفونه"
  },
  {
   "a": 12.39,
   "z": 14.43,
   "text": "والكادو يطلع بالحظ"
  },
  {
   "a": 14.43,
   "z": 15.845,
   "text": "مشروب لاش"
  },
  {
   "a": 15.845,
   "z": 16.91,
   "text": "رميز"
  },
  {
   "a": 16.91,
   "z": 18.869999999999997,
   "text": "ولا الكادو الكبير"
  },
  {
   "a": 18.869999999999997,
   "z": 21.085,
   "text": "أنت تختار الكادوات؟"
  },
  {
   "a": 21.085,
   "z": 23.34,
   "text": "وجداش حظ كل واحدة"
  },
  {
   "a": 23.34,
   "z": 24.994999999999997,
   "text": "يجي للمحل"
  },
  {
   "a": 24.994999999999997,
   "z": 26.42,
   "text": "يوريك الكود"
  },
  {
   "a": 26.42,
   "z": 28.075,
   "text": "وتعطيه اللي ربحه"
  },
  {
   "a": 28.075,
   "z": 30.725,
   "text": "ويرشع باش يدور مرة أخرى"
  },
  {
   "a": 30.725,
   "z": 32.71,
   "text": "جرب بوانتني بلاش"
  },
  {
   "a": 32.71,
   "z": 35.352,
   "text": "واكتب رولات في الكومنتر"
  }
