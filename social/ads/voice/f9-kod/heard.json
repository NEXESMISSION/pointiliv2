{
 "phrases": [
  {
   "a": 0,
   "z": 1.76,
   "text": "سؤال جينديم"
  },
  {
   "a": 1.76,
   "z": 4.035,
   "text": "وكان الحريف صور الكود؟"
  },
  {
   "a": 4.035,
   "z": 6.494999999999999,
   "text": "ويبعد ياخو تampونات من الدار"
  },
  {
   "a": 6.494999999999999,
   "z": 7.835,
   "text": "نينا جمش"
  },
  {
   "a": 7.835,
   "z": 10.79,
   "text": "الكود اللي على الكونتوار يتبدل وحده."
  },
  {
   "a": 10.79,
   "z": 13.245000000000001,
   "text": "وكل كود يفدم مرة برك"
  },
  {
   "a": 13.245000000000001,
   "z": 15.114999999999998,
   "text": "والتصوير الإخداها"
  },
  {
   "a": 15.114999999999998,
   "z": 16.355,
   "text": "فات وقته"
  },
  {
   "a": 16.355,
   "z": 17.35,
   "text": "وزيد"
  },
  {
   "a": 17.35,
   "z": 20.645,
   "text": "أنت تختار كل قداش ينجم ياخو تنبون."
  },
  {
   "a": 20.645,
   "z": 22.39,
   "text": "وكل تنبان مكتوب"
  },
  {
   "a": 22.39,
   "z": 24.07,
   "text": "شكون وقتاش"
  },
  {
   "a": 24.07,
   "z": 25.655,
   "text": "انت تعطي الكادو؟"
  },
  {
   "a": 25.655,
   "z": 26.935000000000002,
   "text": "وانت مرتاح"
  },
  {
   "a": 26.935000000000002,
   "z": 28.865000000000002,
   "text": "جرّب بوانتيلي بلاش"
  },
  {
   "a": 28.865000000000002,
   "z": 31.248,
   "text": "وكتب كود في الكومنتر"
  }
 ],
