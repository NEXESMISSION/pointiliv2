{
 "phrases": [
  {
   "a": 0,
   "z": 2.255,
   "text": "مولا قهوة يسأل"
  },
  {
   "a": 2.255,
   "z": 6.470000000000001,
   "text": "الحريف لازم يحمل أبليكاسيون بشياخو الطنبون"
  },
  {
   "a": 6.470000000000001,
   "z": 7.4350000000000005,
   "text": "لا"
  },
  {
   "a": 7.4350000000000005,
   "z": 9.66,
   "text": "وهذه مبدأ عندنا"
  },
  {
   "a": 9.66,
   "z": 12.31,
   "text": "يسكاني الكود اللي على الكنتوار"
  },
  {
   "a": 12.31,
   "z": 14.059999999999999,
   "text": "بكاميرا تلفونو"
  },
  {
   "a": 14.059999999999999,
   "z": 17.625,
   "text": "أول مرة يعمل كونت بالنمرو متاعه"
  },
  {
   "a": 17.625,
   "z": 19.14,
   "text": "في عشر ثواني"
  },
  {
   "a": 19.14,
   "z": 22.82,
   "text": "والتامبون يتيح طول سلكارت متاعو"
  },
  {
   "a": 22.82,
   "z": 24.89,
   "text": "لا أبليكسيو حملو"
  },
  {
   "a": 24.89,
   "z": 26.950000000000003,
   "text": "لا كارت كرتون تضيع"
  },
  {
   "a": 26.950000000000003,
   "z": 29.095,
   "text": "والكود يتبدل وحده"
  },
  {
   "a": 29.095,
   "z": 30.775,
   "text": "ويخدم مرة برك"
  },
  {
   "a": 30.775,
   "z": 32.31,
   "text": "ما يتسرقش"
  },
  {
   "a": 32.31,
   "z": 34.510000000000005,
   "text": "جرب وانتيلي بلاش"
  },
  {
   "a": 34.510000000000005,
   "z": 36.065,
   "text": "الرابط في البايو"
  },
  {
   "a": 36.065,
   "z": 38.304,
   "text": "ولكتب كارت في الكومنتر"
  }
 ],
