{
 "phrases": [
  {
   "a": 0,
   "z": 3.4000000000000004,
   "text": "تحب الحريف يرجعلك مرة أخرى"
  },
  {
   "a": 3.4000000000000004,
   "z": 6.425,
   "text": "من غير ما تعمل ريميس كل شوية؟"
  },
  {
   "a": 6.425,
   "z": 9.315000000000001,
   "text": "جرب كارت فداليتي بسيطة"
  },
  {
   "a": 9.315000000000001,
   "z": 11.71,
   "text": "مثلاً عندك قهوة"
  },
  {
   "a": 11.71,
   "z": 14.719999999999999,
   "text": "كل ما يشري كهوة يأخو طنبان"
  },
  {
   "a": 14.719999999999999,
   "z": 16.2,
   "text": "يكمل إثمانية"
  },
  {
   "a": 16.2,
   "z": 19.955,
   "text": "ياخو قهوة بلاش ولا كادو تختارو انت"
  },
  {
   "a": 19.955,
   "z": 22.875,
   "text": "الفكرة موش في القهوة البلاش"
  },
  {
   "a": 22.875,
   "z": 26.195,
   "text": "انت هكت تعطيه سبب بشير جعلك"
  },
  {
   "a": 26.195,
   "z": 28.475,
   "text": "في عوض ما يمشي لطهوة أخرى"
  },
  {
   "a": 28.475,
   "z": 29.735,
   "text": "والأمهم"
  },
  {
   "a": 29.735,
   "z": 32.025,
   "text": "متبع عدش الكادو برشا"
  },
  {
   "a": 32.025,
   "z": 34.495,
   "text": "لدرجة الحريف يأس منه"
  },
  {
   "a": 34.495,
   "z": 36.09,
   "text": "أعملها صحيحة"
  },
  {
   "a": 36.09,
   "z": 38.955,
   "text": "وفي عوض حريف يشري مرة وينشي"
  },
  {
   "a": 38.955,
   "z": 41.505,
   "text": "تبني حرفاء يرجعوا لك ديمة"
  },
  {
   "a": 41.505,
   "z": 44.16,
   "text": "وكانت حبها في تلفون الحريف؟"
  },
  {
   "a": 44.16,
   "z": 45.56,
   "text": "بلا تارتون"
  },
  {
   "a": 45.56,
   "z": 46.765,
   "text": "PuanTV"
  },
  {
   "a": 46.765,
   "z": 48.385,
   "text": "عشبتك الفكرة؟"
  },
  {
   "a": 48.385,
   "z": 50.664,
   "text": "اكتب فكرة في الكومنتير"
  }
 ],
