{
 "phrases": [
  {
   "a": 0,
   "z": 2.8049999999999997,
   "text": "وكان التامبونات تولي فلوس"
  },
  {
   "a": 2.8049999999999997,
   "z": 4.81,
   "text": "مع المغازة في بوانتلي،"
  },
  {
   "a": 4.81,
   "z": 8.15,
   "text": "الحريف يلم تنبونات كل مرة يشري"
  },
  {
   "a": 8.15,
   "z": 11.25,
   "text": "ويبدلهم بحاجات من المغازم تاعك"
  },
  {
   "a": 11.25,
   "z": 13.23,
   "text": "عسي 14 تامبونات"
  },
  {
   "a": 13.23,
   "z": 15.17,
   "text": "سندويت بمساواشرين"
  },
  {
   "a": 15.17,
   "z": 16.91,
   "text": "انت تحط الحاجات"
  },
  {
   "a": 16.91,
   "z": 18.6,
   "text": "وانت تحط الصوم"
  },
  {
   "a": 18.6,
   "z": 19.945,
   "text": "هو يختار"
  },
  {
   "a": 19.945,
   "z": 21.73,
   "text": "ويخلص بالتمبونات"
  },
  {
   "a": 21.73,
   "z": 23.8,
   "text": "يوريك الكود في الكاسة"
  },
  {
   "a": 23.8,
   "z": 25.15,
   "text": "ويتسلم حانو"
  },
  {
   "a": 25.15,
   "z": 26.905,
   "text": "و كل ما يلم أكثر"
  },
  {
   "a": 26.905,
   "z": 28.28,
   "text": "يرجع أكثر"
  },
  {
   "a": 28.28,
   "z": 30.315,
   "text": "جدت لباً تليب لش"
  },
  {
   "a": 30.315,
   "z": 32.664,
   "text": "وكتب مغازة في الكومنتير"
  }
 ],
