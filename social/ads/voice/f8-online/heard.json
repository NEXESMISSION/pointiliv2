{
 "phrases": [
  {
   "a": 0,
   "z": 2.8,
   "text": "تبيع في الانستغرام ولا الفيسبوك"
  },
  {
   "a": 2.8,
   "z": 5.744999999999999,
   "text": "الحريفة تشري مرة وتربر"
  },
  {
   "a": 5.744999999999999,
   "z": 8.495000000000001,
   "text": "مع أبوانتي لي بعد كل كوماند"
  },
  {
   "a": 8.495000000000001,
   "z": 10.415,
   "text": "تعمل رابط شيخ تامبون"
  },
  {
   "a": 10.415,
   "z": 12.149999999999999,
   "text": "وتبعثوا في الواتساب"
  },
  {
   "a": 12.149999999999999,
   "z": 13.1,
   "text": "تلو"
  },
  {
   "a": 13.1,
   "z": 15.68,
   "text": "والتامبون يتيح في الكارت متاعها"
  },
  {
   "a": 15.68,
   "z": 17.82,
   "text": "كل رابط يخدم مرة واحدة"
  },
  {
   "a": 17.82,
   "z": 19.200000000000003,
   "text": "وما يوفرش"
  },
  {
   "a": 19.200000000000003,
   "z": 21.215,
   "text": "وانت تعرف شكولك ذا"
  },
  {
   "a": 21.215,
   "z": 23.11,
   "text": "وكل ما تحل الكارت"
  },
  {
   "a": 23.11,
   "z": 25.369999999999997,
   "text": "شوف كداش مازالها للكادو"
  },
  {
   "a": 25.369999999999997,
   "z": 26.8,
   "text": "ترجعلك انت"
  },
  {
   "a": 26.8,
   "z": 28.02,
   "text": "موش لغيرك"
  },
  {
   "a": 28.02,
   "z": 29.98,
   "text": "جربة.تد بلش"
  },
  {
   "a": 29.98,
   "z": 31.464,
   "text": "الرابط في البويو"
  }
 ],
