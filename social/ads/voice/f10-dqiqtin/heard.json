{
 "phrases": [
  {
   "a": 0,
   "z": 4.109999999999999,
   "text": "كيف تأخذك كي تعمل كارت في دلتيل محلك؟"
  },
  {
   "a": 4.109999999999999,
   "z": 5.335,
   "text": "تجيك تين"
  },
  {
   "a": 5.335,
   "z": 7.12,
   "text": "من التدفونمتاك"
  },
  {
   "a": 7.12,
   "z": 8.555,
   "text": "اسم المحل"
  },
  {
   "a": 8.555,
   "z": 10.32,
   "text": "شنو يربح الحريث؟"
  },
  {
   "a": 10.32,
   "z": 11.76,
   "text": "جهوة بلاش"
  },
  {
   "a": 11.76,
   "z": 13.56,
   "text": "جدش من تنبون"
  },
  {
   "a": 13.56,
   "z": 14.594999999999999,
   "text": "ثمانية"
  },
  {
   "a": 14.594999999999999,
   "z": 15.945,
   "text": "اللون متاعك"
  },
  {
   "a": 15.945,
   "z": 17.415,
   "text": "واللوم تحك"
  },
  {
   "a": 17.415,
   "z": 19.115000000000002,
   "text": "وهو الكود حاضر"
  },
  {
   "a": 19.115000000000002,
   "z": 20.75,
   "text": "حطوا على الكونتوار"
  },
  {
   "a": 20.75,
   "z": 22.52,
   "text": "والحرفاء اسكانيو"
  },
  {
   "a": 22.52,
   "z": 24.009999999999998,
   "text": "والكار تتعمر"
  },
  {
   "a": 24.009999999999998,
   "z": 27.57,
   "text": "لا كرتون، لا مطبعة، لا أبليكاسيون."
  },
  {
   "a": 27.57,
   "z": 29.352,
   "text": "غرب بوانتي لبارش"
  }
