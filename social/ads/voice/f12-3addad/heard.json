 "phrases": [
  {
   "a": 0,
   "z": 3.12,
   "text": "عندك حرفة إلمو تنبونات"
  },
  {
   "a": 3.12,
   "z": 4.615,
   "text": "ويغيبوا شهر؟"
  },
  {
   "a": 4.615,
   "z": 6.27,
   "text": "شعل العدد"
  },
  {
   "a": 6.27,
   "z": 8.075,
   "text": "انتختار الأيام"
  },
  {
   "a": 8.075,
   "z": 9.925,
   "text": "15 يوم مثلاً"
  },
  {
   "a": 9.925,
   "z": 12.82,
   "text": "إلي مخدش تنبون في 15 يوم"
  },
  {
   "a": 12.82,
   "z": 15.29,
