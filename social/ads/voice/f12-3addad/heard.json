  },
  {
   "a": 25.02,
   "z": 26.525,
   "text": "وقف العداد"
  },
  {
   "a": 26.525,
   "z": 28.93,
   "text": "وما حد يرسر حتى تنبون"
  },
  {
   "a": 28.93,
