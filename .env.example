# Pointili Tampon — environment variables. Copy to `.env.local` and fill in.
# `.env.local` is gitignored and must stay that way: DATABASE_URL is a live database.
#
# The spec allows exactly these and nothing else.

# ── Supabase project (tampon-test for building; tampon-prod on Vercel) ────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Client identity cookie (required, >= 32 chars) ─────────────────────────
# Signs the anonymous pointili_client cookie. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLIENT_SESSION_SECRET=

# ── The exact host baked into every QR (no trailing slash, must not redirect) ─
NEXT_PUBLIC_SITE_URL=https://t.pointili.online

# ── Database, for scripts/*.mjs only ───────────────────────────────────────
# DATABASE_URL is the TEST project. DATABASE_URL_PROD is read only behind
# `--prod --i-know` (see scripts/migrate.mjs).
DATABASE_URL=postgresql://...
DATABASE_URL_PROD=

# ── Who becomes super_admin at signup (comma-separated) ────────────────────
# Read by scripts/migrate.mjs and written into platform_settings.super_admin_emails.
SUPER_ADMIN_EMAILS=you@example.com
