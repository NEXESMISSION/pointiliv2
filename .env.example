# Pointidi — copy to .env.local and fill in. Never commit .env.local.

# ── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Scripts only (migrations over the Management API, HTTPS) ────────────
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# ── The public origin baked into every QR code (no trailing slash) ──────
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ── Who is promoted to admin by `npm run migrate` (comma-separated) ─────
ADMIN_PHONES=
ADMIN_EMAILS=

# ── SMS for password-reset codes (optional) ─────────────────────────────
# Without a provider, codes are printed in the server log and shown on screen
# in development only. In production, set a provider or recovery is disabled.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
